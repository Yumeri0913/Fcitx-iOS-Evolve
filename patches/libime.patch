+/**
+ * Keys adjacent on a staggered keyboard: same row left/right, plus keys in the
+ * row above/below whose centers are at most one key width away horizontally.
+ * Each row is given with the x offset of its first key center, in key widths.
+ *
+ * Vertical neighbors only take effect when touch data is available (see
+ * PinyinDictionary matching), otherwise only same-row neighbors are accepted.
+ */
+std::unordered_map<char, std::vector<char>> mappingFromStaggeredRows(
+    const std::vector<std::pair<std::string, float>> &rows) {
+    std::unordered_map<char, std::vector<char>> result =
+        mappingFromRows([&rows]() {
+            std::vector<std::string> plain;
+            for (const auto &row : rows) {
+                plain.push_back(row.first);
+            }
+            return plain;
+        }());
+    for (size_t r = 0; r < rows.size(); r++) {
+        for (size_t i = 0; i < rows[r].first.size(); i++) {
+            const char key = rows[r].first[i];
+            const float x = rows[r].second + static_cast<float>(i);
+            for (size_t other : {r - 1, r + 1}) {
+                if (other >= rows.size()) {
+                    continue;
+                }
+                for (size_t j = 0; j < rows[other].first.size(); j++) {
+                    const float ox =
+                        rows[other].second + static_cast<float>(j);
+                    if (std::abs(ox - x) <= 1.0F) {
+                        result[key].push_back(rows[other].first[j]);
+                    }
+                }
+            }
+        }
+    }
+    return result;
+}

+void PinyinEngine::loadUserData() {
+    const auto &standardPath = StandardPaths::global();
+    do {
+        auto file =
+            standardPath.open(StandardPathsType::PkgData, "pinyin/user.dict");
+
+        if (!file.isValid()) {
+            break;
+        }
+
+        try {
+            IFDStreamBuf buffer(file.fd());
+            std::istream in(&buffer);
+            ime_->dict()->load(libime::PinyinDictionary::UserDict, in,
+                               libime::PinyinDictFormat::Binary);
+        } catch (const std::exception &e) {
+            PINYIN_ERROR() << "Failed to load pinyin dict: " << e.what();
+        }
+    } while (0);
+    do {
+        auto file =
+            standardPath.open(StandardPathsType::PkgData, "pinyin/user.history",
+                              StandardPathsMode::User);
+
+        try {
+            IFDStreamBuf buffer(file.fd());
+            std::istream in(&buffer);
+            ime_->model()->load(in);
+        } catch (const std::exception &e) {
+            PINYIN_ERROR() << "Failed to load pinyin history: " << e.what();
+        }
+    } while (0);
+    englishWords_.clear();
+    do {
+        auto file =
+            standardPath.open(StandardPathsType::PkgData, "pinyin/user.english",
+                              StandardPathsMode::User);
+        if (!file.isValid()) {
+            break;
+        }
+        try {
+            IFDStreamBuf buffer(file.fd());
+            std::istream in(&buffer);
+            englishWords_.load(in);
+        } catch (const std::exception &e) {
+            PINYIN_ERROR() << "Failed to load English user words: " << e.what();
+        }
+    } while (0);
+    typedHistory_.clear();
+    do {
+        auto file =
+            standardPath.open(StandardPathsType::PkgData, "pinyin/user.typed",
+                              StandardPathsMode::User);
+        if (!file.isValid()) {
+            break;
+        }
+        try {
+            IFDStreamBuf buffer(file.fd());
+            std::istream in(&buffer);
+            typedHistory_.load(in);
+        } catch (const std::exception &e) {
+            PINYIN_ERROR() << "Failed to load typed code history: " << e.what();
+        }
+    } while (0);
+}

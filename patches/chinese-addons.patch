+    // fcitx5-ios: user.dict and user.history belong to the keyboard. The main
+    // app shares the same data directory with App Group, and saving its stale
+    // copy would overwrite words learned in the keyboard.
+    if (const char *env = std::getenv("F5I_ENV");
+        env && std::string_view(env) == "main") {
+        return;
+    }
     const auto &standardPath = StandardPaths::global();
     standardPath.safeSave(
         StandardPathsType::PkgData, "pinyin/user.dict", [this](int fd) {

+
+// Typo correction of learned words, by touch position: how much less likely
+// (log10) the corrected keys may be in total, and the extra cost of each
+// correction, the same as a pinyin correction (one fuzzy unit, log10(2)).
+const float englishCorrectionMaxPenalty =
+    envFloat("FCITX_PINYIN_LEARNED_CORRECTION_MAX_PENALTY", 4.0F);
+const float englishCorrectionCost = 0.30103F;
+// A word committed for a code one key away from what was typed competes with
+// the words committed for the typed code by log10(count) - penalty, and is
+// offered when that is at least this (e.g. used 100 times, 10 times less
+// likely touch: 2 - 1 = 1). Tuned with scripts/google-pinyin-benchmark.py on
+// a real Google Pinyin user dictionary: lower corrects more typos of words
+// used before, and more often turns a word never typed before into one used
+// before.
+const float typedCorrectionMinScore =
+    envFloat("FCITX_PINYIN_TYPED_CORRECTION_MIN_SCORE", 1.0F);
+
+// Whether typed letters spell the selected words' pinyin, each syllable typed
+// in full or abbreviated to a prefix. A commit that does not (a keyboard
+// correction) is not recorded under what was typed.
+bool typedSpellsSelection(const libime::PinyinContext &context,
+                          std::string_view typed) {
+    std::vector<std::string> syllables;
+    for (const auto &[word, code] : context.selectedWordsWithPinyin()) {
+        if (code.empty()) {
+            // not from the pinyin dictionary, e.g. a learned English word
+            return true;
+        }
+        for (auto &syllable : stringutils::split(
+                 libime::PinyinEncoder::decodeFullPinyin(code), "'")) {
+            syllables.push_back(std::move(syllable));
+        }
+    }
+    std::vector<bool> reachable(typed.size() + 1, false);
+    reachable[0] = true;
+    for (const auto &syllable : syllables) {
+        std::vector<bool> next(typed.size() + 1, false);
+        for (size_t pos = 0; pos < typed.size(); pos++) {
+            if (!reachable[pos]) {
+                continue;
+            }
+            for (size_t len = 1;
+                 len <= syllable.size() && pos + len <= typed.size(); len++) {
+                if (typed[pos + len - 1] != syllable[len - 1]) {
+                    break;
+                }
+                next[pos + len] = true;
+            }
+        }
+        reachable = std::move(next);
+    }
+    return reachable[typed.size()];
+}

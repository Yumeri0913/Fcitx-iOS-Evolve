+void PinyinEngine::learnEnglishWord(InputContext *inputContext,
+                                    const std::string &word) {
+    auto *state = inputContext->propertyFor(&factory_);
+    state->undoEnglishWord_.clear();
+    if (!shouldLearn(inputContext) || !EnglishUserWords::isLearnable(word)) {
+        return;
+    }
+    englishWords_.learn(word);
+    state->undoEnglishWord_ = word;
+}
+
+void PinyinEngine::forgetEnglishWord(InputContext *inputContext,
+                                     const std::string &word) {
+    auto *state = inputContext->propertyFor(&factory_);
+    englishWords_.remove(word);
+
+    const std::string currentInput = state->context_.userInput();
+    resetForgetCandidate(inputContext);
+    doReset(inputContext);
+    state->context_.type(currentInput);
+    updateUI(inputContext);
+}

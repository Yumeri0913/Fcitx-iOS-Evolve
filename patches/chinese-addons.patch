+#ifndef _PINYIN_ENGLISHUSERWORDS_H_
+#define _PINYIN_ENGLISHUSERWORDS_H_
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <istream>
+#include <optional>
+#include <ostream>
+#include <string>
+#include <string_view>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+namespace fcitx {
+
+// English words the user committed as raw input (Enter while composing). Like
+// Google Pinyin, they are learned and come back as candidates when typed again.
+// Words are matched case-insensitively and shown as last typed.
+class EnglishUserWords {
+public:
+    static constexpr size_t MaxWords = 5000;
+    static constexpr uint32_t MaxCount = 0xffff;
+
+    struct Lookup {
+        std::optional<std::string> exact;
+        std::vector<std::string> completions;
+    };
+
+    // Only plain words made of ASCII letters, as typed on the pinyin keyboard.
+    static bool isLearnable(std::string_view word) {
+        if (word.size() < 2 || word.size() > 64) {
+            return false;
+        }
+        return std::ranges::all_of(word, [](char c) {
+            return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z');
+        });
+    }
+
+    static std::string normalize(std::string_view word) {
+        std::string key(word);
+        for (auto &c : key) {
+            if (c >= 'A' && c <= 'Z') {
+                c = static_cast<char>(c - 'A' + 'a');
+            }
+        }
+        return key;
+    }
+
+    void learn(std::string_view word) {
+        if (!isLearnable(word)) {
+            return;
+        }
+        auto &entry = words_[normalize(word)];
+        entry.word = word;
+        entry.count = std::min(entry.count + 1, MaxCount);
+        entry.stamp = ++clock_;
+        if (words_.size() > MaxWords) {
+            evictOldest();
+        }
+    }
+
+    // Undo one learn() of word, e.g. it was deleted right after commit.
+    void unlearn(std::string_view word) {
+        auto iter = words_.find(normalize(word));
+        if (iter == words_.end()) {
+            return;
+        }
+        if (iter->second.count <= 1) {
+            words_.erase(iter);
+        } else {
+            --iter->second.count;
+        }
+    }
+
+    void remove(std::string_view word) { words_.erase(normalize(word)); }
+
+    void clear() { words_.clear(); }
+
+    bool empty() const { return words_.empty(); }
+
+    // Learned word equal to input, and up to maxCompletions longer words
+    // starting with it, most used first.
+    Lookup lookup(std::string_view input, size_t maxCompletions) const {
+        Lookup result;
+        if (!isLearnable(input)) {
+            return result;
+        }
+        const auto key = normalize(input);
+        std::vector<const Entry *> completions;
+        for (const auto &[wordKey, entry] : words_) {
+            if (wordKey == key) {
+                result.exact = entry.word;
+            } else if (wordKey.size() > key.size() &&
+                       wordKey.starts_with(key)) {
+                completions.push_back(&entry);
+            }
+        }
+        std::ranges::sort(completions, [](const Entry *lhs, const Entry *rhs) {
+            if (lhs->count != rhs->count) {
+                return lhs->count > rhs->count;
+            }
+            return lhs->stamp > rhs->stamp;
+        });
+        for (const auto *entry : completions) {
+            if (result.completions.size() >= maxCompletions) {
+                break;
+            }
+            result.completions.push_back(entry->word);
+        }
+        return result;
+    }
+
+    // One word per line: word<TAB>count<TAB>stamp
+    void load(std::istream &in) {
+        words_.clear();
+        clock_ = 0;
+        std::string line;
+        while (std::getline(in, line)) {
+            auto tab1 = line.find('\t');
+            if (tab1 == std::string::npos) {
+                continue;
+            }
+            auto tab2 = line.find('\t', tab1 + 1);
+            std::string word = line.substr(0, tab1);
+            if (!isLearnable(word)) {
+                continue;
+            }
+            Entry entry;
+            entry.word = word;
+            try {
+                entry.count = static_cast<uint32_t>(std::stoul(line.substr(
+                    tab1 + 1, tab2 == std::string::npos ? std::string::npos
+                                                        : tab2 - tab1 - 1)));
+                if (tab2 != std::string::npos) {
+                    entry.stamp = std::stoull(line.substr(tab2 + 1));
+                }
+            } catch (...) {
+                continue;
+            }
+            if (entry.count == 0) {
+                continue;
+            }
+            entry.count = std::min(entry.count, MaxCount);
+            clock_ = std::max(clock_, entry.stamp);
+            words_[normalize(word)] = std::move(entry);
+        }
+        while (words_.size() > MaxWords) {
+            evictOldest();
+        }
+    }
+
+    void save(std::ostream &out) const {
+        std::vector<const Entry *> entries;
+        entries.reserve(words_.size());
+        for (const auto &[_, entry] : words_) {
+            entries.push_back(&entry);
+        }
+        std::ranges::sort(entries, [](const Entry *lhs, const Entry *rhs) {
+            return lhs->stamp < rhs->stamp;
+        });
+        for (const auto *entry : entries) {
+            out << entry->word << '\t' << entry->count << '\t' << entry->stamp
+                << '\n';
+        }
+    }
+
+private:
+    struct Entry {
+        std::string word;
+        uint32_t count = 0;
+        uint64_t stamp = 0;
+    };
+
+    void evictOldest() {
+        auto oldest = std::ranges::min_element(
+            words_, [](const auto &lhs, const auto &rhs) {
+                return lhs.second.stamp < rhs.second.stamp;
+            });
+        if (oldest != words_.end()) {
+            words_.erase(oldest);
+        }
+    }
+
+    std::unordered_map<std::string, Entry> words_;
+    uint64_t clock_ = 0;
+};
+
+} // namespace fcitx
+
+#endif // _PINYIN_ENGLISHUSERWORDS_H_
